{
    "name": "zasmall/webhook-relay-signature",
    "description": "Sign and verify Webhook Relay signatures (X-Relay-Signature), with Laravel middleware for receivers.",
    "type": "library",
    "license": "MIT",
    "keywords": ["webhooks", "hmac", "signature", "laravel"],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "suggest": {
        "illuminate/http": "Required for the VerifyRelaySignature middleware (^13.0)."
    },
    "autoload": {
        "psr-4": {
            "Zasmall\\RelaySignature\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zasmall\\RelaySignature\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zasmall\\RelaySignature\\Laravel\\RelaySignatureServiceProvider"
            ],
            "aliases": {}
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
